{
  "name": "learning-system",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=@learning-system/api",
    "dev:web": "npm run dev --workspace=web",
    "build:packages": "npm run build --workspace=@learning-system/types && npm run build --workspace=@learning-system/sm2-engine",
    "build:api": "npm run build:packages && npm run build --workspace=@learning-system/api",
    "build:web": "npm run build --workspace=web",
    "build": "npm run build:api && npm run build:web",
    "start": "node apps/api/dist/server.js",
    "start:api": "npm start --workspace=@learning-system/api",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:dev": "docker compose up -d postgres redis",
    "db:migrate": "npm run prisma migrate dev --workspace=@learning-system/api",
    "db:seed": "npm run db:seed --workspace=@learning-system/api"
  }
}
